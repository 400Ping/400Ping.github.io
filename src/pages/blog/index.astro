---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
const touched = (p: any) => (p.data.updatedDate ?? p.data.pubDate).valueOf();

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Group by topic/project, newest-touched first within and across groups.
const groupsMap = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.project ?? 'Notes';
  if (!groupsMap.has(key)) groupsMap.set(key, []);
  groupsMap.get(key)!.push(post);
}
const groups = [...groupsMap.entries()]
  .map(([topic, items]) => ({
    topic,
    items: items.sort((a, b) => touched(b) - touched(a)),
  }))
  .sort((a, b) => touched(b.items[0]) - touched(a.items[0]));
---

<BaseLayout title="Writing" description="Living notes on LLM/ML, ML infrastructure, systems, and open source.">
  <div class="shell shell--wide">
    <header class="page-intro">
      <p class="micro-label">Writing / living notes</p>
      <h1>Notes, grouped by topic.</h1>
      <p class="page-lead">
        Many of these are living documents that get revised as the work evolves, so read the
        <em>updated</em> date rather than the date a note was first posted.
      </p>
      <p class="mono-links">
        <a href="/">Profile</a>
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="quiet-note">No posts yet.</p>
      ) : (
        groups.map((group, i) => (
          <section class:list={['section-block', 'section-block--tight', { 'last-section': i === groups.length - 1 }]}>
            <div class="section-rail">
              <h2>{group.topic}</h2>
              <span class="rail-note">{group.items.length} {group.items.length === 1 ? 'note' : 'notes'}</span>
            </div>
            <div class="section-content">
              <ul class="post-list">
                {group.items.map((post) => {
                  const updated = post.data.updatedDate;
                  return (
                    <li>
                      <div>
                        <div class="pl-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></div>
                        {post.data.description && <span class="pl-desc">{post.data.description}</span>}
                      </div>
                      <time datetime={(updated ?? post.data.pubDate).toISOString()}>
                        {updated ? `Updated ${fmt(updated)}` : fmt(post.data.pubDate)}
                      </time>
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>
