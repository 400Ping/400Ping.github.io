---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROFILE, ABOUT } from '../data/profile';
import { NEWS } from '../data/news';
import { OPENSOURCE } from '../data/opensource';
import { TALKS, EDUCATION, SKILLS } from '../data/misc';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
const L = PROFILE.links;
const starBadge = (repo: string) =>
  `https://img.shields.io/github/stars/${repo}?style=flat&logo=github&logoColor=888&label=%E2%98%85&labelColor=00000000&color=888888`;
---

<BaseLayout>
  <header class="masthead">
    <h1>{PROFILE.name}</h1>
    <div class="identity">{PROFILE.identity.join(' · ')}</div>
    <div class="contacts">
      <a href={`mailto:${L.email}`}>Email</a>
      <a href={L.github} target="_blank" rel="noopener">GitHub</a>
      <a href={L.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </header>

  <section class="about">
    {ABOUT.map((para) => <p set:html={para} />)}
  </section>

  <h2 class="section-title">News</h2>
  <ul class="news">
    {
      NEWS.map((n) => (
        <li>
          <div class="when">{n.date}</div>
          <div class="what" set:html={n.html} />
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">Open Source</h2>
  {
    OPENSOURCE.map((proj) => (
      <div class="project">
        <div class="project-head">
          <span class="name"><a href={proj.href} target="_blank" rel="noopener">{proj.name}</a></span>
          {proj.repo && (
            <a href={`https://github.com/${proj.repo}`} target="_blank" rel="noopener" aria-label={`${proj.name} on GitHub`}>
              <img class="badge" src={starBadge(proj.repo)} alt={`GitHub stars for ${proj.repo}`} loading="lazy" decoding="async" height="20" />
            </a>
          )}
          <span class="role">{proj.role}</span>
        </div>
        <div class="period">{proj.period}</div>
        <ul class="project-items">
          {proj.items.map((item) => (
            <li>
              <span set:html={item.html} />
              {item.links.length > 0 && (
                <span class="refs">
                  {item.links.map((lk) => (
                    <a href={lk.href} target="_blank" rel="noopener">{lk.label}</a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <h2 class="section-title">Talks &amp; Articles</h2>
  <ul class="talks">
    {
      TALKS.map((t) => (
        <li>
          {t.href ? (
            <a href={t.href} target="_blank" rel="noopener">{t.title}</a>
          ) : (
            <span>{t.title}</span>
          )}
          {t.venue && <span class="venue"> — {t.venue}</span>}
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">Education</h2>
  {
    EDUCATION.map((e) => (
      <div class="edu">
        <div>
          <div class="school">{e.school}</div>
          <div class="degree">{e.degree}{e.note ? ` · ${e.note}` : ''}</div>
        </div>
        <div class="period">{e.period}</div>
      </div>
    ))
  }

  <h2 class="section-title">Skills</h2>
  <div class="skills">
    {
      SKILLS.map((s) => (
        <div class="skills-group">
          <span class="label">{s.group}</span>
          <div class="tags">
            {s.items.map((it) => <span class="tag">{it}</span>)}
          </div>
        </div>
      ))
    }
  </div>

  {
    posts.length > 0 && (
      <>
        <h2 class="section-title">Writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </li>
          ))}
        </ul>
        <p style="margin-top:1.1rem"><a href="/blog/">All posts →</a></p>
      </>
    )
  }
</BaseLayout>
