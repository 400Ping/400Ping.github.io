---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROFILE, TAGLINE, STATS, FOCUS } from '../data/profile';
import { NEWS } from '../data/news';
import { OPENSOURCE } from '../data/opensource';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
const recentNews = NEWS.slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="eyebrow">{PROFILE.identity[1]} · {PROFILE.identity[2]}</div>
    <h1>{PROFILE.name}</h1>
    <p class="lead">{TAGLINE}</p>
    <div class="btn-row">
      <a class="btn primary" href="/opensource/">View open source</a>
      <a class="btn ghost" href="/about/">About me</a>
      <a class="btn ghost" href="/blog/">Blog</a>
    </div>
  </section>

  <div class="stats">
    {
      STATS.map((s) => (
        <div class="stat">
          <div class="value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))
    }
  </div>

  <h2 class="section-title">Focus</h2>
  <div class="cards">
    {
      FOCUS.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))
    }
  </div>

  <h2 class="section-title">Recent news</h2>
  <ul class="news">
    {
      recentNews.map((n) => (
        <li>
          <div class="when">{n.date}</div>
          <div class="what" set:html={n.html} />
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">Selected work</h2>
  <div class="selected">
    {
      OPENSOURCE.map((proj) => (
        <a class="row" href="/opensource/">
          <span class="name">{proj.name}</span>
          <span class="role">{proj.role}</span>
          <span class="desc" set:html={proj.items[0].html} />
        </a>
      ))
    }
  </div>
  <a class="more-link" href="/opensource/">All open source →</a>

  {
    posts.length > 0 && (
      <>
        <h2 class="section-title">Latest writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            </li>
          ))}
        </ul>
        <a class="more-link" href="/blog/">All posts →</a>
      </>
    )
  }
</BaseLayout>
