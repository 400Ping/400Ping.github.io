---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROFILE, ABOUT } from '../data/profile';
import { NEWS } from '../data/news';
import { OPENSOURCE } from '../data/opensource';
import { TALKS, EDUCATION, SKILLS } from '../data/misc';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
const L = PROFILE.links;
---

<BaseLayout>
  <header class="masthead">
    <h1>{PROFILE.name}</h1>
    <div class="identity">{PROFILE.identity.join(' · ')}</div>
    <div class="contacts">
      <a href={`mailto:${L.email}`}>{L.email}</a>
      <span class="sep">|</span>
      <a href={L.github} target="_blank" rel="noopener">GitHub</a>
      <span class="sep">|</span>
      <a href={L.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </header>

  <section class="about">
    {ABOUT.map((para) => <p set:html={para} />)}
  </section>

  <h2>News</h2>
  <ul class="news">
    {
      NEWS.map((n) => (
        <li>
          <span class="when">{n.date}</span> — <span set:html={n.html} />
        </li>
      ))
    }
  </ul>

  <h2>Open Source</h2>
  {
    OPENSOURCE.map((proj) => (
      <div class="os-project">
        <h3><a href={proj.href} target="_blank" rel="noopener">{proj.name}</a></h3>
        <span> — {proj.role}</span>
        <div class="os-meta">{proj.period}</div>
        <ul class="os-items">
          {proj.items.map((item) => (
            <li>
              <span set:html={item.html} />
              {item.links.length > 0 && (
                <span class="reflist">
                  {' ('}
                  {item.links.map((lk, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={lk.href} target="_blank" rel="noopener">{lk.label}</a>
                    </>
                  ))}
                  {')'}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <h2>Talks &amp; Articles</h2>
  <ul class="talks">
    {
      TALKS.map((t) => (
        <li>
          {t.href ? (
            <a href={t.href} target="_blank" rel="noopener">{t.title}</a>
          ) : (
            <span>{t.title}</span>
          )}
          {t.venue && <span>. {t.venue}</span>}
        </li>
      ))
    }
  </ul>

  <h2>Education</h2>
  {
    EDUCATION.map((e) => (
      <div class="edu">
        <span class="school">{e.school}</span>, {e.degree}.
        <span class="detail"> {e.period}{e.note ? ` · ${e.note}` : ''}.</span>
      </div>
    ))
  }

  <h2>Skills</h2>
  <div class="skills">
    {
      SKILLS.map((s) => (
        <p><span class="label">{s.group}:</span> {s.items.join(', ')}</p>
      ))
    }
  </div>

  {
    posts.length > 0 && (
      <>
        <h2>Writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <span class="date">{fmt(post.data.pubDate)}</span> — {' '}
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
        <p><a href="/blog/">More →</a></p>
      </>
    )
  }
</BaseLayout>
