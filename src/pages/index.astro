---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PROFILE, TAGLINE, HOME_INTRO } from '../data/profile';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
const L = PROFILE.links;
// "Jie-Kai Chang" -> gradient the first name, keep the rest.
const [firstName, ...rest] = PROFILE.name.split(' ');
---

<BaseLayout>
  <section class="home-hero">
    <span class="eyebrow">EE undergrad · Open-source systems</span>
    <h1>Hi, I'm <span class="grad">{firstName}</span> {rest.join(' ')}.</h1>
    <p class="lead">{HOME_INTRO}</p>
    <div class="btn-row">
      <a class="btn primary" href="/cv/">View my CV</a>
      <a class="btn ghost" href="/blog/">Read the blog</a>
      <a class="btn ghost" href={L.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <>
        <h2 class="section-title">Latest writing</h2>
        <div class="blog-cards">
          {posts.map((post) => (
            <a class="blog-card" href={`/blog/${post.id}/`}>
              <span class="date">{fmt(post.data.pubDate)}</span>
              <span class="title">{post.data.title}</span>
              {post.data.description && <p class="excerpt">{post.data.description}</p>}
            </a>
          ))}
        </div>
        <a class="more-link" href="/blog/">All posts →</a>
      </>
    )
  }

  <div class="elsewhere">
    <span>{TAGLINE}</span>
    <div class="contacts">
      <a href={`mailto:${L.email}`}>Email</a>
      <a href={L.github} target="_blank" rel="noopener">GitHub</a>
      <a href={L.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</BaseLayout>
