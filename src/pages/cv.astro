---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE, AREAS } from '../data/profile';
import { OPENSOURCE } from '../data/opensource';
import { PUBLICATIONS, COMMUNITY, TALKS, EDUCATION, SKILLS } from '../data/misc';

const L = PROFILE.links;
---

<BaseLayout title="CV" description="Jie-Kai Chang — CV: open-source experience, community service, publications, talks, education, and skills.">
  <div class="shell shell--wide">
    <header class="page-intro">
      <p class="micro-label">Curriculum vitae / {PROFILE.location}</p>
      <h1>Open-source work, organized by project.</h1>
      <p class="page-lead">{PROFILE.identity.join(' · ')}.</p>
      <p class="mono-links">
        <a href="/">Profile</a><span>/</span>
        <a href={`mailto:${L.email}`}>Email</a><span>/</span>
        <a href={L.github} target="_blank" rel="noopener">GitHub</a><span>/</span>
        <a href={L.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </header>

    <section class="section-block section-block--tight" id="experience">
      <div class="section-rail">
        <h2>Experience</h2>
        <span class="rail-note">{OPENSOURCE.length} projects</span>
      </div>
      <div class="section-content">
        <div class="work-list">
          {
            OPENSOURCE.map((proj) => (
              <article class="work-entry">
                <div class="work-entry__meta">
                  <span>{proj.role}</span>
                  <span>{proj.period}</span>
                </div>
                <h3>
                  {proj.icon && (
                    <span class="logo-tile"><img src={proj.icon} alt="" loading="lazy" decoding="async" /></span>
                  )}
                  <a href={proj.href} target="_blank" rel="noopener">{proj.name}</a>
                </h3>
                <ul class="work-items">
                  {proj.items.map((item) => (
                    <li>
                      <span set:html={item.html} />
                      {item.links.length > 0 && (
                        <span class="refs">
                          {item.links.map((lk) => (
                            <a href={lk.href} target="_blank" rel="noopener">{lk.label}</a>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
                {proj.repo && (
                  <p class="mono-links" style="margin-top:1.2rem">
                    <a href={`https://github.com/${proj.repo}`} target="_blank" rel="noopener">Code</a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-block--tight" id="service">
      <div class="section-rail"><h2>Leadership &amp; service</h2></div>
      <div class="section-content">
        <div class="row-list">
          {
            COMMUNITY.map((c) => (
              <div class="row">
                <div class="row__main">
                  {c.icon && (
                    <span class="logo-tile sm"><img src={c.icon} alt="" loading="lazy" decoding="async" /></span>
                  )}
                  <div>
                    <div class="row__title">
                      {c.role} ·{' '}
                      {c.href ? <a href={c.href} target="_blank" rel="noopener">{c.org}</a> : <span>{c.org}</span>}
                    </div>
                    <div class="row__sub">{c.desc}</div>
                  </div>
                </div>
                <div class="row__when">{c.period}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      PUBLICATIONS.length > 0 && (
        <section class="section-block section-block--tight" id="publications">
          <div class="section-rail"><h2>Publications</h2></div>
          <div class="section-content">
            <div class="row-list">
              {PUBLICATIONS.map((p) => {
                const links = p.links.filter((l) => l.href);
                return (
                  <article class="pub">
                    <div class="pub__meta">{[p.venue, p.year].filter(Boolean).join(' / ')}</div>
                    <h3>{p.title}</h3>
                    {p.authors && (
                      <p class="authors" set:html={p.authors.replace(/Jie-Kai Chang/g, '<span class="me">Jie-Kai Chang</span>')} />
                    )}
                    {links.length > 0 && (
                      <p class="refs">
                        {links.map((l) => (
                          <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                        ))}
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <section class="section-block section-block--tight" id="talks">
      <div class="section-rail"><h2>Talks &amp; articles</h2></div>
      <div class="section-content">
        <div class="row-list">
          {
            TALKS.map((t) => (
              <div class="row">
                <div class="row__main">
                  <div class="row__title">
                    {t.href ? <a href={t.href} target="_blank" rel="noopener">{t.title}</a> : <span>{t.title}</span>}
                  </div>
                </div>
                {t.venue && <div class="row__when">{t.venue}</div>}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-block--tight" id="education">
      <div class="section-rail"><h2>Education</h2></div>
      <div class="section-content">
        <div class="row-list">
          {
            EDUCATION.map((e) => (
              <div class="row">
                <div class="row__main">
                  {e.icon && (
                    <span class="logo-tile sm"><img src={e.icon} alt="" loading="lazy" decoding="async" /></span>
                  )}
                  <div>
                    <div class="row__title">{e.school}</div>
                    <div class="row__sub">{e.degree}{e.note ? ` · ${e.note}` : ''}</div>
                  </div>
                </div>
                <div class="row__when">{e.period}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-block section-block--tight last-section" id="skills">
      <div class="section-rail"><h2>Skills &amp; areas</h2></div>
      <div class="section-content">
        <div class="skills">
          <div class="skills-group">
            <span class="label">Research areas</span>
            <div class="items">{AREAS.join(' / ')}</div>
          </div>
          {
            SKILLS.map((s) => (
              <div class="skills-group">
                <span class="label">{s.group}</span>
                <div class="items">{s.items.join(' / ')}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
