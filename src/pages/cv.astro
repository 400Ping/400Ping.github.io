---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE, ABOUT, STATS, AREAS } from '../data/profile';
import { OPENSOURCE } from '../data/opensource';
import { PUBLICATIONS, TALKS, EDUCATION, SKILLS } from '../data/misc';

const L = PROFILE.links;
const starBadge = (repo: string) =>
  `https://img.shields.io/github/stars/${repo}?style=flat&logo=github&logoColor=888&label=%E2%98%85&labelColor=00000000&color=888888`;
---

<BaseLayout title="CV" description="Jie-Kai Chang — CV: open-source experience, education, and skills.">
  <header class="masthead">
    <h1>{PROFILE.name}</h1>
    <div class="identity">{PROFILE.identity.join(' · ')} · {PROFILE.location}</div>
    <div class="contacts">
      <a href={`mailto:${L.email}`}>Email</a>
      <a href={L.github} target="_blank" rel="noopener">GitHub</a>
      <a href={L.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </header>

  <section class="about">
    {ABOUT.map((para) => <p set:html={para} />)}
  </section>

  <div class="stats">
    {
      STATS.map((s) => (
        <div class="stat">
          <div class="value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))
    }
  </div>

  <h2 class="section-title">Research areas</h2>
  <div class="tags">
    {AREAS.map((a) => <span class="tag">{a}</span>)}
  </div>

  <h2 class="section-title">Experience</h2>
  {
    OPENSOURCE.map((proj) => (
      <div class="project">
        <div class="project-head">
          <span class="name"><a href={proj.href} target="_blank" rel="noopener">{proj.name}</a></span>
          {proj.repo && (
            <a href={`https://github.com/${proj.repo}`} target="_blank" rel="noopener" aria-label={`${proj.name} on GitHub`}>
              <img class="badge" src={starBadge(proj.repo)} alt={`GitHub stars for ${proj.repo}`} loading="lazy" decoding="async" height="20" />
            </a>
          )}
          <span class="role">{proj.role}</span>
        </div>
        <div class="period">{proj.period}</div>
        <ul class="project-items">
          {proj.items.map((item) => (
            <li>
              <span set:html={item.html} />
              {item.links.length > 0 && (
                <span class="refs">
                  {item.links.map((lk) => (
                    <a href={lk.href} target="_blank" rel="noopener">{lk.label}</a>
                  ))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  {
    PUBLICATIONS.length > 0 && (
      <>
        <h2 class="section-title">Publications</h2>
        <ol class="pubs">
          {PUBLICATIONS.map((p) => {
            const links = p.links.filter((l) => l.href);
            return (
              <li class="pub">
                <div class="title">{p.title}</div>
                {p.authors && (
                  <div class="authors" set:html={p.authors.replace(/Jie-Kai Chang/g, '<span class="me">Jie-Kai Chang</span>')} />
                )}
                <div class="venue">{[p.venue, p.year].filter(Boolean).join(', ')}</div>
                {links.length > 0 && (
                  <div class="refs">
                    {links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                    ))}
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </>
    )
  }

  <h2 class="section-title">Talks &amp; Articles</h2>
  <ul class="talks">
    {
      TALKS.map((t) => (
        <li>
          {t.href ? (
            <a href={t.href} target="_blank" rel="noopener">{t.title}</a>
          ) : (
            <span>{t.title}</span>
          )}
          {t.venue && <span class="venue"> — {t.venue}</span>}
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">Education</h2>
  {
    EDUCATION.map((e) => (
      <div class="edu">
        <div>
          <div class="school">{e.school}</div>
          <div class="degree">{e.degree}{e.note ? ` · ${e.note}` : ''}</div>
        </div>
        <div class="period">{e.period}</div>
      </div>
    ))
  }

  <h2 class="section-title">Skills</h2>
  <div class="skills">
    {
      SKILLS.map((s) => (
        <div class="skills-group">
          <span class="label">{s.group}</span>
          <div class="tags">
            {s.items.map((it) => <span class="tag">{it}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
